<%
    const money = (value) => '₹' + Number(value || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const displayName = (profile && profile.name) ? profile.name : 'there';
%>
<%- include('../partials/layout-top', { pageTitle: 'Dashboard' }) %>

<div class="page-head">
    <div>
        <p class="eyebrow"><%= isGroupAccount ? 'Group overview' : 'Personal overview' %></p>
        <h1 class="page-title">Welcome, <%= displayName %></h1>
        <p class="page-sub">
            <%= isGroupAccount
                ? (account.messName ? account.messName + ' · ' : '') + 'Contributions, expenses and meals for ' + periodLabel + '.'
                : 'Your income, spending and balance for ' + periodLabel + '.' %>
        </p>
    </div>
    <div class="page-actions">
        <%- include('../partials/monthFilter') %>
        <a class="btn btn-primary" href="/add-entry">
            <%- include('../partials/icon', { name: 'plus' }) %>
            <%= isGroupAccount ? 'Add money' : 'Add income' %>
        </a>
    </div>
</div>

<section class="stat-grid" aria-label="Summary for <%= periodLabel %>">
    <article class="stat is-violet">
        <div class="stat-top">
            <span class="stat-label">Available balance</span>
            <span class="stat-icon"><%- include('../partials/icon', { name: 'wallet' }) %></span>
        </div>
        <p class="stat-value"><%= money(availableBalance) %></p>
        <p class="stat-note"><%= isGroupAccount ? 'Contributions less expenses' : 'Income less expenses' %></p>
    </article>

    <article class="stat is-income">
        <div class="stat-top">
            <span class="stat-label"><%= isGroupAccount ? 'Contributions' : 'Income' %></span>
            <span class="stat-icon"><%- include('../partials/icon', { name: 'arrow-up' }) %></span>
        </div>
        <p class="stat-value"><%= money(incomeTotal) %></p>
        <p class="stat-note"><%= incomeCount %> <%= incomeCount === 1 ? 'entry' : 'entries' %> this month</p>
    </article>

    <article class="stat is-expense">
        <div class="stat-top">
            <span class="stat-label">Expenses</span>
            <span class="stat-icon"><%- include('../partials/icon', { name: 'arrow-down' }) %></span>
        </div>
        <p class="stat-value"><%= money(expenseTotal) %></p>
        <p class="stat-note"><%= expenseCount %> <%= expenseCount === 1 ? 'entry' : 'entries' %> this month</p>
    </article>

    <% if (isGroupAccount) { %>
        <article class="stat is-meal">
            <div class="stat-top">
                <span class="stat-label">Per meal price</span>
                <span class="stat-icon"><%- include('../partials/icon', { name: 'meal' }) %></span>
            </div>
            <p class="stat-value"><%= money(perMealPrice) %></p>
            <p class="stat-note"><%= Number(grandTotalFood || 0).toLocaleString('en-IN') %> meals recorded</p>
        </article>
    <% } else { %>
        <article class="stat is-teal">
            <div class="stat-top">
                <span class="stat-label">Transactions</span>
                <span class="stat-icon"><%- include('../partials/icon', { name: 'receipt' }) %></span>
            </div>
            <p class="stat-value"><%= transactionCount %></p>
            <p class="stat-note">Recorded in <%= periodLabel %></p>
        </article>
    <% } %>
</section>

<section class="card mt-2" aria-labelledby="trend-title">
    <div class="card-head">
        <div>
            <h2 id="trend-title">Performance</h2>
            <p><%= isGroupAccount ? 'Contributions and expenses' : 'Income and spending' %> · last six months</p>
        </div>
        <div class="trend-legend" aria-hidden="true">
            <span class="is-income"><%= isGroupAccount ? 'Contributions' : 'Income' %></span>
            <span class="is-expense">Expenses</span>
        </div>
    </div>
    <div class="card-body">
        <div class="trend-chart" role="group" aria-label="Six month trend of <%= isGroupAccount ? 'contributions and expenses' : 'income and expenses' %>">
            <% trend.forEach((row, index) => { %>
                <%
                    const incomeHeight = Math.max(row.income > 0 ? 4 : 1.5, Math.round((row.income / trendMax) * 100));
                    const expenseHeight = Math.max(row.expense > 0 ? 4 : 1.5, Math.round((row.expense / trendMax) * 100));
                    const isCurrent = row.month === month && row.year === year;
                %>
                <a class="trend-col <%= isCurrent ? 'is-current' : '' %>"
                   href="/?month=<%= row.month %>&year=<%= row.year %>"
                   title="<%= row.label %> <%= row.year %> · <%= isGroupAccount ? 'Contributions' : 'Income' %> <%= money(row.income) %> · Expenses <%= money(row.expense) %>"
                   aria-label="<%= row.label %> <%= row.year %>. <%= isGroupAccount ? 'Contributions' : 'Income' %> <%= money(row.income) %>, expenses <%= money(row.expense) %>.">
                    <span class="trend-bars" aria-hidden="true">
                        <span class="trend-bar is-income <%= row.income > 0 ? '' : 'is-zero' %>" style="--h: <%= incomeHeight %>; --i: <%= index %>;"></span>
                        <span class="trend-bar is-expense <%= row.expense > 0 ? '' : 'is-zero' %>" style="--h: <%= expenseHeight %>; --i: <%= index %>;"></span>
                    </span>
                    <span class="trend-label"><%= row.label %></span>
                </a>
            <% }) %>
        </div>
    </div>
</section>

<div class="split mt-2">
    <section class="card" aria-labelledby="recent-title">
        <div class="card-head">
            <div>
                <h2 id="recent-title">Recent activity</h2>
                <p>Latest <%= periodLabel %> movements</p>
            </div>
            <a class="btn-link" href="/transactions?month=<%= month %>&year=<%= year %>">View all</a>
        </div>

        <% if (!recentTransactions.length) { %>
            <div class="empty-state">
                <span class="empty-icon"><%- include('../partials/icon', { name: 'receipt' }) %></span>
                <h3>Nothing recorded yet</h3>
                <p>Entries you add for this month will appear here with their date and amount.</p>
                <a class="btn btn-secondary btn-sm" href="/add-entry"><%= isGroupAccount ? 'Add the first contribution' : 'Add your first income' %></a>
            </div>
        <% } else { %>
            <ul class="list">
                <% recentTransactions.forEach(tx => { %>
                    <li class="list-item">
                        <span class="list-indicator <%= tx.type === 'expense' ? 'is-expense' : (tx.type === 'meal' ? 'is-meal' : '') %>">
                            <%- include('../partials/icon', { name: tx.type === 'expense' ? 'arrow-down' : (tx.type === 'meal' ? 'meal' : 'arrow-up') }) %>
                        </span>
                        <div class="list-copy">
                            <strong><%= tx.title %></strong>
                            <% if (tx.detail) { %><span><%= tx.detail %></span><% } %>
                        </div>
                        <time class="list-date" datetime="<%= new Date(tx.date).toISOString() %>">
                            <%= new Date(tx.date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %>
                        </time>
                        <span class="list-amount <%= tx.type === 'expense' ? 'is-expense' : (tx.type === 'meal' ? 'is-meal' : '') %>">
                            <%= tx.type === 'expense' ? '−' : (tx.type === 'meal' ? '' : '+') %><%= tx.type === 'meal' ? tx.amount + (Number(tx.amount) === 1 ? ' meal' : ' meals') : money(tx.amount) %>
                        </span>
                    </li>
                <% }) %>
            </ul>
        <% } %>
    </section>

    <div class="stack">
        <section class="card">
            <div class="card-head">
                <h2>Quick actions</h2>
            </div>
            <div class="card-body stack-sm">
                <a class="btn btn-secondary btn-block" href="/add-entry">
                    <%- include('../partials/icon', { name: 'plus' }) %>
                    <%= isGroupAccount ? 'Record a contribution' : 'Record income' %>
                </a>
                <a class="btn btn-secondary btn-block" href="/add-expense">
                    <%- include('../partials/icon', { name: 'minus' }) %>
                    Add an expense
                </a>
                <% if (isGroupAccount) { %>
                    <a class="btn btn-secondary btn-block" href="/add-Meal">
                        <%- include('../partials/icon', { name: 'meal' }) %>
                        Add today’s meal count
                    </a>
                    <a class="btn btn-secondary btn-block" href="/final-settlement">
                        <%- include('../partials/icon', { name: 'shield' }) %>
                        Open final settlement
                    </a>
                <% } else { %>
                    <a class="btn btn-secondary btn-block" href="/reports">
                        <%- include('../partials/icon', { name: 'chart' }) %>
                        Open monthly report
                    </a>
                    <a class="btn btn-secondary btn-block" href="/year-history">
                        <%- include('../partials/icon', { name: 'calendar' }) %>
                        Browse year history
                    </a>
                <% } %>
            </div>
        </section>

        <section class="card">
            <div class="card-head">
                <h2><%= isGroupAccount ? 'This mess' : 'This month' %></h2>
            </div>
            <div class="card-body">
                <dl class="detail-list">
                    <% if (isGroupAccount) { %>
                        <div class="detail-row">
                            <dt>Mess</dt>
                            <dd><%= account.messName || 'Mess account' %></dd>
                        </div>
                        <div class="detail-row">
                            <dt>Group ID</dt>
                            <dd><%= account.groupId || '—' %></dd>
                        </div>
                        <div class="detail-row">
                            <dt>Members</dt>
                            <dd><%= memberCount %></dd>
                        </div>
                        <div class="detail-row">
                            <dt>Meals recorded</dt>
                            <dd><%= Number(grandTotalFood || 0).toLocaleString('en-IN') %></dd>
                        </div>
                    <% } else { %>
                        <div class="detail-row">
                            <dt>Income</dt>
                            <dd><%= money(incomeTotal) %></dd>
                        </div>
                        <div class="detail-row">
                            <dt>Expenses</dt>
                            <dd><%= money(expenseTotal) %></dd>
                        </div>
                        <div class="detail-row">
                            <dt>Saved</dt>
                            <dd><%= money(availableBalance) %></dd>
                        </div>
                        <div class="detail-row">
                            <dt>Account type</dt>
                            <dd><span class="badge badge-info">Personal</span></dd>
                        </div>
                    <% } %>
                </dl>
            </div>
        </section>
    </div>
</div>

<%- include('../partials/layout-bottom') %>
