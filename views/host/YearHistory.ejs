<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#0a74da">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <title>CashBook || Transactions</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <%- include('../partials/loader') %>  
    <div id="app">
        <%- include('../partials/header') %>    
        <!-- Main Content -->
        <main class="main-content">
            <h2>📆 Yearly History</h2>

            <% if (years.length === 0) { %>
                <p>No data found</p>
            <% } %>

            
             <% years.forEach(y => { %>
                <div class="card yearly-card">
                    <div class="card-header">
                        <h3><%= y.year %></h3>
                        <span class="badge">Yearly Summary</span>
                    </div>
                    
                    <div class="stats-grid">
                        <div class="stat-item">
                            <span class="label">Income</span>
                            <span class="value income-text">₹ <%= y.income %></span>
                        </div>
                        <div class="stat-item">
                            <span class="label">Expense</span>
                            <span class="value expense-text">₹ <%= y.expense %></span>
                        </div>
                    </div>

                    <div class="balance-row">
                        <div class="balance-info">
                            <span class="label">Net Balance</span>
                            <span class="balance-amount">₹ <%= y.balance %></span>
                        </div>
                        <a href="/year-history/<%= y.year %>" class="btn-glass">
                            View Details
                        </a>
                    </div>
                </div>
            <% }) %>
        </main>
    </div>
<%- include('../partials/pwa') %>
</body>
</html>