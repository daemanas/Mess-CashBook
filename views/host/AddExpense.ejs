<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CashBook || Entry</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div id="app">
        <%- include('../partials/header') %>
        <!-- Main Content -->
        <main class="main-content">
            <!-- Add Entry Page -->
            <div id="add-entry-page" class="page">
                <h2>Add Expense</h2>
                <div class="card">
                    <form id="add-entry-form" action="/add-expense" method="POST">
                                                    
                        <div class="dashboard-actions">
                            <a href="/add-entry" class="action-btn income-btn">
                                ➕ Add Member
                            </a>
                            <a href="/add-expense" class="action-btn expense-btn">
                                ➖ Add Expense
                            </a>
                            <a href="/add-Meal" class="action-btn income-btn">
                                ➕ Add Meal
                            </a>
                        </div>
                       

                        <div class="main-form">
                            <div class="form-group">
                                <label for="entry_date">Date</label>
                                <input type="date" class="entry_date" id="entry_date" name="entry_date" required>
                            </div>
                            <div id="itemsContainer">
                                <div class="item-row">
                                    <div class="form-group">
                                        <label for="entry_title">Item Name</label>
                                        <input type="text" class="entry_title" id="vag_name" name="vag_name[]" placeholder="Vag" required>
                                    </div>
                                    <div class="form-group">
                                        <label for="entry_amount">Amount</label>
                                        <input type="number" class="entry_amount" id="entry_amount" name="entry_amount[]" placeholder="Enter amount" required>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <button type="button" onclick="addMoreItem()" class="btn btn-success">+ Add More</button>
                        <br>
                        <hr>
                        
                        <div class="d-flex" style="gap: 1rem;">
                            <button type="reset" class="btn btn-outline">Reset</button>
                            <button type="submit" class="btn btn-success">Save Entry</button>
                            
                        </div>
                    </form>
                </div>
            </div>
        </main>
    </div>
    <script>
        function addMoreItem() {
            const container = document.getElementById('itemsContainer');
            const div = document.createElement("div");
            div.className = 'item-row' ;
            div.innerHTML =
            `
            <div class="form-group">
                <label for="entry_title">Item Name</label>
                <input type="text" class="entry_title" id="vag_name" name="vag_name[]" placeholder="Vag" required>
            </div>
            <div class="form-group">
                <label for="entry_amount">Amount</label>
                <input type="number" class="entry_amount" id="entry_amount" name="entry_amount[]" placeholder="Enter amount" required>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="btn btn-success"> <h1>X</h1></button>
            `;
            container.appendChild(div)
        }
    </script>
</body>
</html>