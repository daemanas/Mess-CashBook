<%
    const rows = (form && Array.isArray(form.entries) && form.entries.length) ? form.entries : [{ name: '', rawAmount: '' }];
    const dateValue = (form && form.entry_date) ? form.entry_date : entryDate;
%>
<%- include('../partials/layout-top', { pageTitle: 'Add expense' }) %>

<div class="page-head">
    <div>
        <p class="eyebrow">Expenses</p>
        <h1 class="page-title">Record expenses</h1>
        <p class="page-sub">Add one or several items bought on the same date. Each item is stored as its own record.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary" href="/expentionAdded">
            <%- include('../partials/icon', { name: 'list' }) %>
            Expense list
        </a>
    </div>
</div>

<div class="split">
    <section class="card">
        <div class="card-head">
            <div>
                <h2>Expense details</h2>
                <p>Every row is saved with the same date.</p>
            </div>
        </div>
        <div class="card-body">
            <% if (locals.error) { %>
                <div class="alert alert-error" role="alert" style="margin-bottom: 15px;">
                    <%- include('../partials/icon', { name: 'alert' }) %>
                    <span><%= error %></span>
                </div>
            <% } %>

            <form class="form" action="/add-expense" method="POST" data-expense-form>
                <div class="field">
                    <label class="label" for="expense-date">Date</label>
                    <input class="input" id="expense-date" type="date" name="entry_date"
                           value="<%= dateValue %>" required>
                </div>

                <div class="field">
                    <span class="label">
                        Items
                        <span>Title and amount per row</span>
                    </span>

                    <div class="expense-rows" data-expense-rows>
                        <% rows.forEach(row => { %>
                            <div class="expense-row">
                                <input class="input" type="text" name="vag_name"
                                       value="<%= row.name || '' %>" placeholder="Item, e.g. Vegetables"
                                       maxlength="80" required>
                                <input class="input expense-amount" type="number" name="entry_amount"
                                       value="<%= row.rawAmount !== undefined ? row.rawAmount : '' %>"
                                       placeholder="0.00" min="0.01" step="0.01" inputmode="decimal" required>
                                <button class="icon-btn" type="button" data-remove-row aria-label="Remove this item">
                                    <%- include('../partials/icon', { name: 'trash' }) %>
                                </button>
                            </div>
                        <% }) %>
                    </div>

                    <button class="btn btn-secondary btn-sm" type="button" data-add-row>
                        <%- include('../partials/icon', { name: 'plus' }) %>
                        Add another item
                    </button>
                </div>

                <div class="row-total">
                    <span>Total for this date</span>
                    <strong data-expense-total>₹0.00</strong>
                </div>

                <div class="form-actions">
                    <button class="btn btn-primary" type="submit">
                        <%- include('../partials/icon', { name: 'check' }) %>
                        Save expenses
                    </button>
                    <a class="btn btn-ghost" href="/">Cancel</a>
                </div>
            </form>
        </div>
    </section>

    <section class="card">
        <div class="card-head">
            <h2>Good to know</h2>
        </div>
        <div class="card-body">
            <ul class="list" style="margin: -8px -20px -20px;">
                <li class="list-item">
                    <span class="list-indicator is-expense"><%- include('../partials/icon', { name: 'receipt' }) %></span>
                    <div class="list-copy">
                        <strong>One row, one record</strong>
                        <span>Items stay individually deletable later</span>
                    </div>
                </li>
                <li class="list-item">
                    <span class="list-indicator"><%- include('../partials/icon', { name: 'shield' }) %></span>
                    <div class="list-copy">
                        <strong>Account scoped</strong>
                        <span><%= account.isMess ? 'Group ID: ' + account.groupId : 'Visible only to you' %></span>
                    </div>
                </li>
                <li class="list-item">
                    <span class="list-indicator is-meal"><%- include('../partials/icon', { name: 'calculator' }) %></span>
                    <div class="list-copy">
                        <strong>Feeds meal pricing</strong>
                        <span>Monthly expenses set the per-meal price</span>
                    </div>
                </li>
            </ul>
        </div>
    </section>
</div>

<%- include('../partials/layout-bottom') %>
