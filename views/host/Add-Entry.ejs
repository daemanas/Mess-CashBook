<%
    const value = (key, fallback) => (form && form[key] !== undefined && form[key] !== null) ? form[key] : fallback;
%>
<%- include('../partials/layout-top', { pageTitle: isGroupAccount ? 'Add money' : 'Add income' }) %>

<div class="page-head">
    <div>
        <p class="eyebrow"><%= isGroupAccount ? 'Contributions' : 'Income' %></p>
        <h1 class="page-title"><%= isGroupAccount ? 'Record a money contribution' : 'Record income' %></h1>
        <p class="page-sub">
            <%= isGroupAccount
                ? 'Add a payment made by a member. Amounts create the contribution ledger used by billing and settlement.'
                : 'Add money you received. Each entry builds your monthly and yearly summary.' %>
        </p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary" href="/moneyAdded">
            <%- include('../partials/icon', { name: 'list' }) %>
            <%= isGroupAccount ? 'Money added' : 'Income list' %>
        </a>
    </div>
</div>

<div class="split">
    <section class="card member-picker-card">
        <div class="card-head">
            <div>
                <h2>Entry details</h2>
                <p>All values are saved against your authenticated account.</p>
            </div>
        </div>
        <div class="card-body">
            <% if (locals.error) { %>
                <div class="alert alert-error" role="alert" style="margin-bottom: 15px;">
                    <%- include('../partials/icon', { name: 'alert' }) %>
                    <span><%= error %></span>
                </div>
            <% } %>

            <form class="form" action="/add-entry" method="POST">
                <div class="field">
                    <% if (isGroupAccount) { %>
                        <%- include('../partials/memberPicker', {
                            pickerId: 'entry-title',
                            pickerName: 'entry_title',
                            pickerLabel: 'Member name',
                            pickerValue: value('entry_title', title),
                            pickerPlaceholder: 'Choose or enter a member name',
                            selectedMemberId: value('memberId', ''),
                            members
                        }) %>
                        <p class="hint">Choose a registered group member, or enter a manual contribution label.</p>
                    <% } else { %>
                        <label class="label" for="entry-title">
                            Income source
                            <span>e.g. Salary, Freelance</span>
                        </label>
                        <input class="input" id="entry-title" type="text" name="entry_title"
                               value="<%= value('entry_title', title) %>"
                               placeholder="e.g. Salary" maxlength="80" autocomplete="off" required autofocus>
                        <p class="hint">A short label that makes this income easy to recognise later.</p>
                    <% } %>
                </div>

                <div class="form-row">
                    <div class="field">
                        <label class="label" for="entry-amount">Amount (₹)</label>
                        <input class="input" id="entry-amount" type="number" name="entry_amount"
                               value="<%= value('entry_amount', '') %>"
                               placeholder="0.00" min="0.01" step="0.01" inputmode="decimal" required>
                    </div>

                    <div class="field">
                        <label class="label" for="entry-date">Date</label>
                        <input class="input" id="entry-date" type="date" name="entry_date"
                               value="<%= value('entry_date', entryDate) %>" required>
                    </div>
                </div>

                <div class="form-actions">
                    <button class="btn btn-primary" type="submit">
                        <%- include('../partials/icon', { name: 'check' }) %>
                        Save entry
                    </button>
                    <a class="btn btn-ghost" href="/">Cancel</a>
                </div>
            </form>
        </div>
    </section>

    <section class="card">
        <div class="card-head">
            <h2>Good to know</h2>
        </div>
        <div class="card-body">
            <ul class="list" style="margin: -8px -20px -20px;">
                <li class="list-item">
                    <span class="list-indicator"><%- include('../partials/icon', { name: 'shield' }) %></span>
                    <div class="list-copy">
                        <strong>Saved to your account only</strong>
                        <span><%= isGroupAccount ? 'Filtered by your Group ID' : 'Filtered by your user ID' %></span>
                    </div>
                </li>
                <li class="list-item">
                    <span class="list-indicator"><%- include('../partials/icon', { name: 'calendar' }) %></span>
                    <div class="list-copy">
                        <strong>Month and year follow the date</strong>
                        <span>Use the real payment date for accurate reports</span>
                    </div>
                </li>
                <% if (isGroupAccount) { %>
                    <li class="list-item">
                        <span class="list-indicator is-meal"><%- include('../partials/icon', { name: 'meal' }) %></span>
                        <div class="list-copy">
                            <strong>Meal ledger created automatically</strong>
                            <span>New member names get an empty meal register</span>
                        </div>
                    </li>
                <% } %>
            </ul>
        </div>
    </section>
</div>

<%- include('../partials/layout-bottom') %>
