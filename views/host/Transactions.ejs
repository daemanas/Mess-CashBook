<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#0a74da">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <title>CashBook || Transactions</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <%- include('../partials/loader') %>  
    <div id="app">
        <%- include('../partials/header') %>    
        <!-- Main Content -->
        <main class="main-content">

            <!-- Transactions Page -->
            <div id="transactions-page" class="page">
                <h2>Transactions</h2>
                

                <form method="GET" action="/transactions" class="search-filter">
                    <div class="search-box">
                        <input type="text" name="search" placeholder="Search transactions..."
                            value="<%= filters.search || '' %>">
                    </div>

                    <div class="filters">
                        <select name="type">
                            <option value="">All Types</option>
                            <option value="income" <%= filters.type==='income'?'selected':'' %>>Income</option>
                            <option value="expense" <%= filters.type==='expense'?'selected':'' %>>Expense</option>
                        </select>

                        <input type="date" name="from" value="<%= filters.from || '' %>">
                        <input type="date" name="to" value="<%= filters.to || '' %>">

                        <button type="submit" class="btn btn-outline">Filter</button>
                    </div>
                </form>

                <div class="card">
                    <div class="table-container">
                        <table>
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Title</th>
                                    <th>Category</th>
                                    <th>Amount</th>
                                    <th>Type</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            
                            <tbody>
                                <% if (transactions.length === 0) { %>
                                    <tr>
                                        <td colspan="6" style="text-align:center;">No transactions found</td>
                                    </tr>
                                <% } %>

                                <% transactions.forEach(t => { %>
                                <tr>
                                    <td><%= t.date.toISOString().split('T')[0] %></td>
                                    <td><%= t.title %></td>
                                    <td><%= t.category %></td>
                                    <td>₹ <%= t.amount %></td>
                                    <td>
                                        <% if (t.type === 'income') { %>
                                            <span class="badge badge-income">Income</span>
                                        <% } else { %>
                                            <span class="badge badge-expense">Expense</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (user.role === 'admin') { %>
                                            <button class="btn btn-sm btn-danger">Delete</button>
                                        <% } else { %>
                                            —
                                        <% } %>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>

                        </table>
                    </div>
                    


                    <ul class="pagination">

                        <% if (currentPage > 1) { %>
                            <li>
                                <a href="?page=<%= currentPage - 1 %>">Prev</a>
                            </li>
                        <% } %>

                        <% for (let i = 1; i <= totalPages; i++) { %>
                            <li>
                                <a href="?page=<%= i %>" 
                                class="<%= currentPage === i ? 'active' : '' %>">
                                    <%= i %>
                                </a>
                            </li>
                        <% } %>

                        <% if (currentPage < totalPages) { %>
                            <li>
                                <a href="?page=<%= currentPage + 1 %>">Next</a>
                            </li>
                        <% } %>

                    </ul>

                </div>
            </div>
        </main>
    </div>
<%- include('../partials/pwa') %>
</body>
</html>