<%
    const code = typeof status !== 'undefined' ? status : 500;
    const heading = typeof title !== 'undefined' && title ? title : (code === 404 ? 'Page not found' : code === 403 ? 'Access denied' : 'Something went wrong');
    const detail = typeof message !== 'undefined' && message ? message : 'The page could not be loaded.';
    const loggedIn = Boolean(locals.account && locals.account.isLoggedIn);
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0b1730">
    <title><%= heading %> · CashBook</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="error-body">
    <main class="error-card">
        <span class="error-code"><%= code %></span>
        <h1><%= heading %></h1>
        <p><%= detail %></p>
        <% if (typeof hint !== 'undefined' && hint) { %>
            <p><%= hint %></p>
        <% } %>

        <div class="error-actions">
            <a class="btn btn-primary" href="<%= loggedIn ? '/' : '/login' %>">
                <%= loggedIn ? 'Back to dashboard' : 'Go to sign in' %>
            </a>
            <% if (loggedIn) { %>
                <a class="btn btn-secondary" href="/transactions">Open ledger</a>
            <% } %>
        </div>
    </main>

    <%- include('../partials/pwa') %>
</body>
</html>
