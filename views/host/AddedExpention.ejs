<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#0a74da">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <title>CashBook || Dashboard</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <%- include('../partials/loader') %> 
    <div id="app">
        <%- include('../partials/header') %>
        <!-- Main Content -->
        <main class="main-content">
            <h2>🥦 Expension Dashboard</h2> 
            <br>   
            <%- include('../partials/monthFilter') %>      
            <br>              

            <% if (expenseCards.length > 0) { %>
                <% expenseCards.forEach(card => { %>

                    <div class="data_containner">
                        <h3>
                            📅 <%= new Date(card.date).toLocaleDateString('en-IN') %>
                        </h3>

                        <div class="card">
                            <div class="table-container">
                                <table>
                                    <thead>
                                        <tr>
                                            <th>Vegetable</th>
                                            <th>Amount</th>
                                            <th>AC</th>
                                        </tr>
                                    </thead>
                                    <tbody>

                                        <% card.items.forEach(item => { %>
                                            <tr>
                                                <td><%= item.name %></td>
                                                <td>₹ <%= item.amount %></td>
                                                
                                                <!-- 🔵 3 DOT MENU -->
                                                <td>
                                                    <div class="dropdown" style="display:inline-block; float:right;">
                                                        <button class="dot-btn">⋮</button>

                                                        <div class="dropdown-menu">
                                                            <form action="/expense-delete-single/<%= item._id %>"
                                                                method="POST">
                                                                <button type="submit"
                                                                        class="delete-btn"
                                                                        onclick="return confirm('এই আইটেমটি ডিলিট করবেন?')">
                                                                    Delete
                                                                </button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }) %>

                                        <!-- Card Total -->
                                        <tr class="total-row">
                                            <td><strong>Total</strong></td>                                         
                                            <td><strong>₹ <%= card.total %></strong></td>
                                            <td></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <form action="/expense-delete-date/<%= card.date.toISOString() %>" 
                        method="POST" 
                        style="margin-top:10px;">

                        <button class="btn btn-danger btn-sm"
                            onclick="return confirm('এই দিনের সব ভেজিটেবল ডিলিট করতে চান?')">
                            Delete Full Card
                        </button>

                    </form>


                <% }) %>

                <!-- 🔥 FINAL GRAND TOTAL -->
                <div class="data_containner">
                    <div class="card">
                        <div class="table-container">
                            <table>
                                <tr class="total-row">
                                    <td><strong>Grand Total</strong></td>
                                    <td><strong>₹ <%= grandTotal %></strong></td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>

            <% } else { %>
                <p>No vegetable expense found</p>
            <% } %>


        </main>
    </div>
<%- include('../partials/pwa') %>
</body>
</html>



