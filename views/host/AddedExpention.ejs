<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CashBook || Dashboard</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <%- include('../partials/loader') %> 
    <div id="app">
        <%- include('../partials/header') %>
        <!-- Main Content -->
        <main class="main-content">
            <h2>🥦 Vegetable Dashboard</h2>

            <% if (expenseCards.length > 0) { %>
                <% expenseCards.forEach(card => { %>

                    <div class="data_containner">
                        <h3>
                            📅 <%= new Date(card.date).toLocaleDateString('en-IN') %>
                        </h3>

                        <div class="card">
                            <div class="table-container">
                                <table>
                                    <thead>
                                        <tr>
                                            <th>Vegetable</th>
                                            <th>Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody>

                                        <% card.items.forEach(item => { %>
                                            <tr>
                                                <td><%= item.name %></td>
                                                <td>₹ <%= item.amount %></td>
                                            </tr>
                                        <% }) %>

                                        <!-- Card Total -->
                                        <tr class="total-row">
                                            <td><strong>Total</strong></td>
                                            <td><strong>₹ <%= card.total %></strong></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <form action="/expense-delete-date/<%= card.date.toISOString() %>" 
                        method="POST" 
                        style="margin-top:10px;">

                        <button class="btn btn-danger btn-sm"
                            onclick="return confirm('এই দিনের সব ভেজিটেবল ডিলিট করতে চান?')">
                            Delete Full Card
                        </button>

                    </form>


                <% }) %>

                <!-- 🔥 FINAL GRAND TOTAL -->
                <div class="data_containner">
                    <div class="card">
                        <table class="entries-table">
                            <tr class="total-row">
                                <td><strong>Grand Total</strong></td>
                                <td><strong>₹ <%= grandTotal %></strong></td>
                            </tr>
                        </table>
                    </div>
                </div>

            <% } else { %>
                <p>No vegetable expense found</p>
            <% } %>


        </main>
    </div>
</body>
</html>



