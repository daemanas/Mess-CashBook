<%
    const money = (value) => '₹' + Number(value || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const canDelete = account.isPersonal || account.isAdmin;
    const dayCount = expenseCards.length;
    const averageDay = dayCount > 0 ? grandTotal / dayCount : 0;
%>
<%- include('../partials/layout-top', { pageTitle: 'Expenses' }) %>

<div class="page-head">
    <div>
        <p class="eyebrow">Expenses</p>
        <h1 class="page-title">Expense records</h1>
        <p class="page-sub"><%= periodLabel %> · every purchase recorded, grouped by the day it was made.</p>
    </div>
    <div class="page-actions">
        <%- include('../partials/monthFilter') %>
        <a class="btn btn-primary" href="/add-expense">
            <%- include('../partials/icon', { name: 'plus' }) %>
            Add expense
        </a>
    </div>
</div>

<div class="grid-3" style="margin-bottom: 16px;">
    <article class="stat is-expense">
        <div class="stat-top">
            <span class="stat-label">Total expenses</span>
            <span class="stat-icon"><%- include('../partials/icon', { name: 'receipt' }) %></span>
        </div>
        <p class="stat-value"><%= money(grandTotal) %></p>
        <p class="stat-note"><%= periodLabel %></p>
    </article>

    <article class="stat">
        <div class="stat-top">
            <span class="stat-label">Items</span>
            <span class="stat-icon"><%- include('../partials/icon', { name: 'list' }) %></span>
        </div>
        <p class="stat-value"><%= entryCount %></p>
        <p class="stat-note">Across <%= dayCount %> <%= dayCount === 1 ? 'day' : 'days' %></p>
    </article>

    <article class="stat is-meal">
        <div class="stat-top">
            <span class="stat-label">Average per day</span>
            <span class="stat-icon"><%- include('../partials/icon', { name: 'chart' }) %></span>
        </div>
        <p class="stat-value"><%= money(averageDay) %></p>
        <p class="stat-note">Days with recorded spending</p>
    </article>
</div>

<% if (!expenseCards.length) { %>
    <section class="card">
        <div class="empty-state">
            <span class="empty-icon"><%- include('../partials/icon', { name: 'receipt' }) %></span>
            <h3>No expenses in <%= periodLabel %></h3>
            <p>Record purchases to keep the month’s spending, per-meal price and settlement accurate.</p>
            <a class="btn btn-primary btn-sm" href="/add-expense">
                <%- include('../partials/icon', { name: 'plus' }) %>
                Add an expense
            </a>
        </div>
    </section>
<% } else { %>
    <div class="stack">
        <% expenseCards.forEach(card => { %>
            <section class="card">
                <div class="card-head">
                    <div>
                        <h2><%= new Date(card.date).toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'long', year: 'numeric' }) %></h2>
                        <p><%= card.items.length %> <%= card.items.length === 1 ? 'item' : 'items' %> · <%= money(card.total) %></p>
                    </div>
                    <div class="page-actions">
                        <a class="btn btn-secondary btn-sm" href="/add-expense">
                            <%- include('../partials/icon', { name: 'plus' }) %>
                            Add
                        </a>
                        <% if (canDelete) { %>
                            <form action="/expense-delete-date/<%= card.key %>" method="POST"
                                  data-confirm="Delete every expense recorded on this date? This cannot be undone."
                                  data-confirm-label="Delete day">
                                <button class="btn btn-danger btn-sm" type="submit">
                                    <%- include('../partials/icon', { name: 'trash' }) %>
                                    Delete day
                                </button>
                            </form>
                        <% } %>
                    </div>
                </div>

                <div class="table-wrap">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th class="is-right">Amount</th>
                                <% if (canDelete) { %><th class="is-right">Action</th><% } %>
                            </tr>
                        </thead>
                        <tbody>
                            <% card.items.forEach(item => { %>
                                <tr>
                                    <td><%= item.name %></td>
                                    <td class="is-right"><span class="table-amount is-expense"><%= money(item.amount) %></span></td>
                                    <% if (canDelete) { %>
                                        <td class="is-right">
                                            <div class="table-actions">
                                                <form action="/expense-delete-single/<%= item._id %>" method="POST"
                                                      data-confirm="Delete <%= item.name %> (<%= money(item.amount) %>)?">
                                                    <button class="btn btn-danger btn-sm" type="submit" aria-label="Delete expense">
                                                        <%- include('../partials/icon', { name: 'trash' }) %>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    <% } %>
                                </tr>
                            <% }) %>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td>Day total</td>
                                <td class="is-right"><%= money(card.total) %></td>
                                <% if (canDelete) { %><td></td><% } %>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </section>
        <% }) %>
    </div>
<% } %>

<%- include('../partials/layout-bottom') %>
