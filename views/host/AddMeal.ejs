<%
    const selectedName = (form && form.name) ? form.name : '';
    const selectedMemberId = (form && form.memberId) ? form.memberId : '';
    const selectedDate = (form && form.entry_date) ? form.entry_date : entryDate;
    const selectedCount = (form && form.food_count !== undefined) ? form.food_count : '';
%>
<%- include('../partials/layout-top', { pageTitle: 'Add meal' }) %>

<div class="page-head">
    <div>
        <p class="eyebrow">Meals</p>
        <h1 class="page-title">Record a meal count</h1>
        <p class="page-sub">Choose a group member, date and whole-number meal count.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary" href="/AddedMeal">
            <%- include('../partials/icon', { name: 'meal' }) %>
            Added meals
        </a>
        <a class="btn btn-secondary" href="/meal-billing">
            <%- include('../partials/icon', { name: 'calculator' }) %>
            Meal billing
        </a>
    </div>
</div>

<div class="split">
    <section class="card member-picker-card">
        <div class="card-head">
            <div>
                <h2>Meal details</h2>
                <p>Admin-managed meal record</p>
            </div>
        </div>
        <div class="card-body">
            <% if (locals.error) { %>
                <div class="alert alert-error" role="alert" style="margin-bottom: 15px;">
                    <%- include('../partials/icon', { name: 'alert' }) %>
                    <span><%= error %></span>
                </div>
            <% } %>

            <% if (!members.length) { %>
                <div class="alert alert-info" style="margin-bottom: 15px;">
                    <%- include('../partials/icon', { name: 'info' }) %>
                    <span>No verified group accounts are available for meal entry.</span>
                </div>
            <% } %>

            <form class="form" action="/add-Meal" method="POST">
                <div class="field">
                    <%- include('../partials/memberPicker', {
                        pickerId: 'meal-name',
                        pickerName: 'name',
                        pickerLabel: 'Member',
                        pickerValue: selectedName,
                        pickerPlaceholder: 'Choose a registered group member',
                        selectedMemberId,
                        members
                    }) %>
                    <p class="hint">Only verified accounts in this group can be assigned a meal record.</p>
                </div>

                <div class="field">
                    <label class="label" for="meal-date">Meal date</label>
                    <input class="input" id="meal-date" type="date" name="entry_date"
                           value="<%= selectedDate %>" required>
                </div>

                <div class="field">
                    <label class="label" for="meal-count">
                        Food count
                        <span>Whole number</span>
                    </label>
                    <input class="input" id="meal-count" type="number" name="food_count"
                           value="<%= selectedCount %>" placeholder="e.g. 2"
                           min="1" step="1" inputmode="numeric" required>
                    <p class="hint">One count per member per date. Admins can remove or adjust an entry from Added meals.</p>
                </div>

                <div class="form-actions">
                    <button class="btn btn-primary" type="submit">
                        <%- include('../partials/icon', { name: 'check' }) %>
                        Save meal
                    </button>
                    <a class="btn btn-ghost" href="/AddedMeal">Cancel</a>
                </div>
            </form>
        </div>
    </section>

    <section class="card">
        <div class="card-head">
            <h2>How meal costing works</h2>
        </div>
        <div class="card-body">
            <ol class="stack-sm ordered-list" style="margin: 0;">
                <li>Every meal count is summed for the selected month.</li>
                <li>Monthly expenses are divided by those meals to get the per-meal price.</li>
                <li>Each member’s payable amount is their count × per-meal price.</li>
                <li>Final settlement compares what they paid with what they owe.</li>
            </ol>
            <div class="alert alert-info mt-2">
                <%- include('../partials/icon', { name: 'info' }) %>
                <div class="alert-copy">
                    <span>Meal data belongs to this mess only and is never shared with personal accounts.</span>
                    <span class="alert-code">Group ID · <%= account.groupId || '—' %></span>
                </div>
            </div>
        </div>
    </section>
</div>

<%- include('../partials/layout-bottom') %>
