<%
    const isAdmin = account.isAdmin;
    const memberCount = users.length;
    const average = memberCount > 0 ? grandTotalFood / memberCount : 0;
    const mealEntries = users.reduce((sum, user) => sum + user.meals.length, 0);
%>
<%- include('../partials/layout-top', { pageTitle: 'Added meals' }) %>

<div class="page-head">
    <div>
        <p class="eyebrow">Meals</p>
        <h1 class="page-title">Added meals</h1>
        <p class="page-sub"><%= periodLabel %> · each member’s daily food count for the selected month.</p>
    </div>
    <div class="page-actions">
        <%- include('../partials/monthFilter') %>
        <a class="btn btn-primary" href="/add-Meal">
            <%- include('../partials/icon', { name: 'plus' }) %>
            Add meal
        </a>
    </div>
</div>

<div class="stat-grid" style="margin-bottom: 16px;">
    <article class="stat is-meal">
        <div class="stat-top">
            <span class="stat-label">Total meals</span>
            <span class="stat-icon"><%- include('../partials/icon', { name: 'meal' }) %></span>
        </div>
        <p class="stat-value"><%= Number(grandTotalFood || 0).toLocaleString('en-IN') %></p>
        <p class="stat-note"><%= periodLabel %></p>
    </article>

    <article class="stat">
        <div class="stat-top">
            <span class="stat-label">Members with meals</span>
            <span class="stat-icon"><%- include('../partials/icon', { name: 'users' }) %></span>
        </div>
        <p class="stat-value"><%= memberCount %></p>
        <p class="stat-note"><%= mealEntries %> daily records</p>
    </article>

    <article class="stat is-teal">
        <div class="stat-top">
            <span class="stat-label">Average per member</span>
            <span class="stat-icon"><%- include('../partials/icon', { name: 'chart' }) %></span>
        </div>
        <p class="stat-value"><%= average.toFixed(2) %></p>
        <p class="stat-note">Meals in this month</p>
    </article>

    <article class="stat is-violet">
        <div class="stat-top">
            <span class="stat-label">Group</span>
            <span class="stat-icon"><%- include('../partials/icon', { name: 'id-card' }) %></span>
        </div>
        <p class="stat-value" style="font-size: 1.15rem;"><%= account.groupId || '—' %></p>
        <p class="stat-note"><%= account.messName || 'Mess account' %></p>
    </article>
</div>

<% if (!users.length) { %>
    <section class="card">
        <div class="empty-state">
            <span class="empty-icon"><%- include('../partials/icon', { name: 'meal' }) %></span>
            <h3>No meals in <%= periodLabel %></h3>
            <p>Add today’s meal counts to start calculating the per-meal price for settlement.</p>
            <a class="btn btn-primary btn-sm" href="/add-Meal">
                <%- include('../partials/icon', { name: 'plus' }) %>
                Add a meal count
            </a>
        </div>
    </section>
<% } else { %>
    <div class="stack">
        <% users.forEach(user => { %>
            <section class="card">
                <div class="card-head">
                    <div>
                        <h2><%= user.name %></h2>
                        <p><%= user.meals.length %> <%= user.meals.length === 1 ? 'day' : 'days' %> · <%= user.userTotal %> meals</p>
                    </div>
                    <div class="page-actions">
                        <span class="badge badge-warning"><%= user.userTotal %> meals</span>
                        <% if (isAdmin) { %>
                            <form action="/meal-delete-user/<%= user._id %>" method="POST"
                                  data-confirm="Delete the entire meal ledger for <%= user.name %>? Recorded counts cannot be restored."
                                  data-confirm-label="Delete ledger">
                                <button class="btn btn-danger btn-sm" type="submit">
                                    <%- include('../partials/icon', { name: 'trash' }) %>
                                    Delete ledger
                                </button>
                            </form>
                        <% } %>
                    </div>
                </div>

                <div class="table-wrap">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th class="is-right">Food count</th>
                                <% if (isAdmin) { %><th class="is-right">Action</th><% } %>
                            </tr>
                        </thead>
                        <tbody>
                            <% user.meals.forEach(meal => { %>
                                <tr>
                                    <td><%= new Date(meal.date).toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }) %></td>
                                    <td class="is-right"><span class="table-amount"><%= meal.food_count %></span></td>
                                    <% if (isAdmin) { %>
                                        <td class="is-right">
                                            <div class="table-actions">
                                                <form action="/meal-delete-single/<%= user._id %>/<%= meal._id %>" method="POST"
                                                      data-confirm="Delete <%= user.name %>’s meal count for this date?">
                                                    <button class="btn btn-danger btn-sm" type="submit" aria-label="Delete meal">
                                                        <%- include('../partials/icon', { name: 'trash' }) %>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    <% } %>
                                </tr>
                            <% }) %>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td>Member total</td>
                                <td class="is-right"><%= user.userTotal %></td>
                                <% if (isAdmin) { %><td></td><% } %>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </section>
        <% }) %>
    </div>
<% } %>

<%- include('../partials/layout-bottom') %>
