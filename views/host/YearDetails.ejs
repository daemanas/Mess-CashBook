<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#0a74da">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <title>CashBook || Transactions</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <%- include('../partials/loader') %>  
    <div id="app">
        <%- include('../partials/header') %>    
        <!-- Main Content -->
        


        <main class="main-content">
                <div class="page-header">
                    <h2>📅 <%= year %> Monthly Summary</h2>
                    <p class="subtitle">Track your performance month by month</p>
                </div>

                <div class="monthly-grid">
                    <% months.forEach(m => { %>
                        <div class="month-card">
                            <div class="month-name">
                                <span><%= m.monthName %></span>
                                <a href="/?month=<%= m.month %>&year=<%= year %>" class="icon-btn">
                                    <span>View Details</span> →
                                </a>
                            </div>

                            <div class="stats-row">
                                <div class="stat-box income">
                                    <label>Income</label>
                                    <p>₹ <%= m.income %></p>
                                </div>
                                <div class="stat-box expense">
                                    <label>Expense</label>
                                    <p>₹ <%= m.expense %></p>
                                </div>
                            </div>

                            <div class="balance-footer">
                                <span class="footer-label">Remaining Balance</span>
                                <span class="footer-value <%= m.balance >= 0 ? 'pos' : 'neg' %>">
                                    ₹ <%= m.balance %>
                                </span>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </main>

    </div>
<%- include('../partials/pwa') %>
</body>
</html>