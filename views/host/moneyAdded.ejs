<%
    const money = (value) => '₹' + Number(value || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const canDelete = account.isPersonal || account.isAdmin;
    const average = entryCount > 0 ? grandTotal / entryCount : 0;
%>
<%- include('../partials/layout-top', { pageTitle: isGroupAccount ? 'Money added' : 'Income' }) %>

<div class="page-head">
    <div>
        <p class="eyebrow"><%= isGroupAccount ? 'Contributions' : 'Income' %></p>
        <h1 class="page-title"><%= isGroupAccount ? 'Money added' : 'Income records' %></h1>
        <p class="page-sub"><%= periodLabel %> · grouped by <%= isGroupAccount ? 'member' : 'income source' %>.</p>
    </div>
    <div class="page-actions">
        <%- include('../partials/monthFilter') %>
        <a class="btn btn-primary" href="/add-entry">
            <%- include('../partials/icon', { name: 'plus' }) %>
            <%= isGroupAccount ? 'Add money' : 'Add income' %>
        </a>
    </div>
</div>

<div class="grid-3" style="margin-bottom: 16px;">
    <article class="stat is-income">
        <div class="stat-top">
            <span class="stat-label">Total <%= isGroupAccount ? 'contributions' : 'income' %></span>
            <span class="stat-icon"><%- include('../partials/icon', { name: 'wallet' }) %></span>
        </div>
        <p class="stat-value"><%= money(grandTotal) %></p>
        <p class="stat-note"><%= periodLabel %></p>
    </article>

    <article class="stat">
        <div class="stat-top">
            <span class="stat-label">Entries</span>
            <span class="stat-icon"><%- include('../partials/icon', { name: 'receipt' }) %></span>
        </div>
        <p class="stat-value"><%= entryCount %></p>
        <p class="stat-note">Individual records this month</p>
    </article>

    <article class="stat is-violet">
        <div class="stat-top">
            <span class="stat-label">Average entry</span>
            <span class="stat-icon"><%- include('../partials/icon', { name: 'chart' }) %></span>
        </div>
        <p class="stat-value"><%= money(average) %></p>
        <p class="stat-note">Across <%= groups.length %> <%= isGroupAccount ? 'members' : 'sources' %></p>
    </article>
</div>

<% if (!groups.length) { %>
    <section class="card">
        <div class="empty-state">
            <span class="empty-icon"><%- include('../partials/icon', { name: 'wallet' }) %></span>
            <h3>No <%= isGroupAccount ? 'contributions' : 'income' %> in <%= periodLabel %></h3>
            <p>Add an entry or choose another month to see recorded amounts grouped here.</p>
            <a class="btn btn-primary btn-sm" href="/add-entry">
                <%- include('../partials/icon', { name: 'plus' }) %>
                Add the first entry
            </a>
        </div>
    </section>
<% } else { %>
    <div class="stack">
        <% groups.forEach(group => { %>
            <section class="card">
                <div class="card-head">
                    <div>
                        <h2><%= group.title %></h2>
                        <p><%= group.entries.length %> <%= group.entries.length === 1 ? 'entry' : 'entries' %> · <%= money(group.total) %></p>
                    </div>
                    <div class="page-actions">
                        <a class="btn btn-secondary btn-sm" href="/add-entry?title=<%= encodeURIComponent(group.title) %>">
                            <%- include('../partials/icon', { name: 'plus' }) %>
                            Add
                        </a>
                        <!-- <% if (canDelete) { %>
                            <form action="/money-delete-group/<%= encodeURIComponent(group.title) %>" method="POST"
                                  data-confirm="Delete every <%= group.title %> entry for this month? This cannot be undone."
                                  data-confirm-label="Delete card">
                                <button class="btn btn-danger btn-sm" type="submit">
                                    <%- include('../partials/icon', { name: 'trash' }) %>
                                    Delete card
                                </button>
                            </form>
                        <% } %> -->
                    </div>
                </div>

                <div class="table-wrap">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th class="is-right">Amount</th>
                                <% if (canDelete) { %><th class="is-right">Action</th><% } %>
                            </tr>
                        </thead>
                        <tbody>
                            <% group.entries.forEach(entry => { %>
                                <tr>
                                    <td>
                                        <%= new Date(entry.entry_date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                        <span class="table-sub">Added <%= new Date(entry.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %></span>
                                    </td>
                                    <td class="is-right"><span class="table-amount is-income"><%= money(entry.entry_amount) %></span></td>
                                    <% if (canDelete) { %>
                                        <td class="is-right">
                                            <div class="table-actions">
                                                <form action="/money-delete-single/<%= entry._id %>" method="POST"
                                                      data-confirm="Delete this <%= money(entry.entry_amount) %> entry?">
                                                    <button class="btn btn-danger btn-sm" type="submit" aria-label="Delete entry">
                                                        <%- include('../partials/icon', { name: 'trash' }) %>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    <% } %>
                                </tr>
                            <% }) %>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td>Total</td>
                                <td class="is-right"><%= money(group.total) %></td>
                                <% if (canDelete) { %><td></td><% } %>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </section>
        <% }) %>
    </div>
<% } %>

<%- include('../partials/layout-bottom') %>
