<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#0a74da">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <title>CashBook || Dashboard</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <%- include('../partials/loader') %> 
    <div id="app">
        <%- include('../partials/header') %>

        <main class="main-content">

        <% if (groups && groups.length > 0) { %>

            <% groups.forEach(group => { %>
                <div class="data_containner">

                    <!-- Card Title -->
                    <h2><%= group.title %></h2>

                    <div class="card">
                        <div class="table-container">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Amount</th>
                                        <th>AC</th>
                                    </tr>
                                </thead>
                                <tbody>

                                    <% group.entries.forEach(e => { %>
                                        <tr>
                                            <td><%= new Date(e.entry_date).toLocaleDateString('en-IN') %></td>
                                            <td>₹<%= e.entry_amount %></td>
                                            <td>
                                                <!-- 🔵 3 DOT MENU -->
                                                <div class="dropdown" style="display:inline-block; float:right;">
                                                    <button class="dot-btn">⋮</button>

                                                    <div class="dropdown-menu">
                                                        <form action="/money-delete-single/<%= e._id %>"
                                                            method="POST">
                                                            <button type="submit"
                                                                    class="delete-btn"
                                                                    onclick="return confirm('এই এন্ট্রিটি ডিলিট করবেন?')">
                                                                Delete
                                                            </button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>

                                    <!-- 🔹 Card-wise Total -->
                                    <tr class="total-row">
                                        <td><strong>Total (<%= group.title %>)</strong></td>
                                        <td></td>
                                        <td><strong>₹<%= group.total %></strong></td>
                                    </tr>

                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <!-- এই বাটনে ক্লিক করলে সেই একই নাম নিয়ে নতুন entry add করবে -->
                <a href="/add-entry?title=<%= encodeURIComponent(group.title) %>" class="btn">
                    Money Add
                </a>

                <form action="/money-delete-group/<%= encodeURIComponent(group.title) %>" 
                    method="POST" 
                    style="margin-top:10px;">

                    <button class="btn btn-danger btn-sm"
                        onclick="return confirm('এই পুরো কার্ড ডিলিট করতে চান?')">
                        Delete Full Card
                    </button>

                </form>


        




            <% }) %>

            <!-- 🔥 Grand Total -->
            <div class="data_containner">
                <div class="card">
                    <div class="table-container">
                        <table >
                            <tr class="total-row">
                                <td><strong>Grand Total</strong></td>
                                <td><strong>₹<%= grandTotal %></strong></td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>

        <% } else { %>
            <h2>No entries found</h2>
        <% } %>

        </main>


    </div>
<%- include('../partials/pwa') %>
</body>
</html>













