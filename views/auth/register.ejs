<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register | CashBook</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="auth-body">

<div class="auth-card">
    <h1>CashBook</h1>
    <p class="subtitle">Complete Registration</p>

    <form action="/register" method="POST">

        <input
            type="text"
            name="name"
            placeholder="Full Name"
            required
        >

        <input
            type="email"
            name="email"
            placeholder="Email (same as OTP)"
            required
        >

        <input
            type="text"
            name="otp"
            placeholder="Enter OTP"
            required
        >

        <input
            type="password"
            name="password"
            placeholder="Password"
            required
        >

        <button type="submit">Register</button>

    </form>

    <p class="switch-text">
        Already have an account?
        <a href="/login">Login</a>
    </p>
</div>

</body>
</html>
