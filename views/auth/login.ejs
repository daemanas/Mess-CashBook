<%- include('../partials/auth-top', { pageTitle: 'Sign in' }) %>

<div class="auth-card-head">
    <a class="brand" href="/login">
        <span class="brand-mark"><%- include('../partials/icon', { name: 'book' }) %></span>
        <span>Cash<span style="color: var(--brand)">Book</span></span>
    </a>
    <h1>Welcome back</h1>
    <p>Sign in to continue to your dashboard, records and settlement.</p>
</div>

<div class="auth-panel">
    <% if (locals.notice) { %>
        <div class="alert alert-success" role="status">
            <%- include('../partials/icon', { name: 'check' }) %>
            <span><%= notice %></span>
        </div>
    <% } %>

    <% if (locals.error) { %>
        <div class="alert alert-error" role="alert" style="margin-bottom: 14px;">
            <%- include('../partials/icon', { name: 'alert' }) %>
            <span><%= error %></span>
        </div>
    <% } %>

    <form class="form" action="/login" method="POST" autocomplete="on">
        <div class="field">
            <label class="label" for="login-email">Email address</label>
            <input class="input" id="login-email" type="email" name="email"
                   value="<%= locals.email || '' %>" placeholder="you@example.com"
                   autocomplete="email" required autofocus>
        </div>

        <div class="field">
            <label class="label" for="login-password">
                Password
                <span><a href="/forgot-password">Forgot password?</a></span>
            </label>
            <div class="password-field">
                <input class="input" id="login-password" type="password" name="password"
                       placeholder="Enter your password" autocomplete="current-password" required>
                <button class="password-toggle" type="button" data-password-toggle="login-password" aria-label="Show password">
                    <%- include('../partials/icon', { name: 'eye' }) %>
                </button>
            </div>
        </div>

        <div class="form-actions">
            <button class="btn btn-primary btn-block" type="submit">Sign in</button>
        </div>
    </form>

    <div class="auth-links">
        <span>New to CashBook?</span>
        <a href="/generateOTP">Create an account</a>
    </div>
</div>

<p class="auth-foot">Existing mess admins and members keep their current Group ID and records.</p>

<%- include('../partials/auth-bottom') %>
