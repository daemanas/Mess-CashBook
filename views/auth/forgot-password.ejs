<%- include('../partials/auth-top', { pageTitle: 'Forgot password' }) %>

<div class="auth-card-head">
    <a class="brand" href="/login">
        <span class="brand-mark"><%- include('../partials/icon', { name: 'book' }) %></span>
        <span>Cash<span style="color: var(--brand)">Book</span></span>
    </a>
    <h1>Forgot your password?</h1>
    <p>Enter your email and we will send a 6-digit reset code. It expires after 5 minutes.</p>
</div>

<div class="auth-panel">
    <% if (locals.error) { %>
        <div class="alert alert-error" role="alert" style="margin-bottom: 14px;">
            <%- include('../partials/icon', { name: 'alert' }) %>
            <span><%= error %></span>
        </div>
    <% } %>

    <form class="form" action="/forgot-password" method="POST">
        <div class="field">
            <label class="label" for="forgot-email">Email address</label>
            <input class="input" id="forgot-email" type="email" name="email"
                   value="<%= locals.email || '' %>" placeholder="you@example.com"
                   autocomplete="email" required autofocus>
        </div>

        <div class="form-actions">
            <button class="btn btn-primary btn-block" type="submit">
                <%- include('../partials/icon', { name: 'mail' }) %>
                Send reset code
            </button>
        </div>
    </form>

    <div class="auth-links">
        <a href="/login">Back to sign in</a>
        <a href="/reset-password">I already have a code</a>
    </div>
</div>

<%- include('../partials/auth-bottom') %>
