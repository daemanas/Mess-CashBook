<%- include('../partials/auth-top', { pageTitle: 'Reset password' }) %>

<div class="auth-card-head">
    <a class="brand" href="/login">
        <span class="brand-mark"><%- include('../partials/icon', { name: 'book' }) %></span>
        <span>Cash<span style="color: var(--brand)">Book</span></span>
    </a>
    <h1>Set a new password</h1>
    <p>Use the reset code from your email. Codes are single use and expire after 5 minutes.</p>
</div>

<div class="auth-panel">
    <% if (locals.notice) { %>
        <div class="alert alert-success" role="status" style="margin-bottom: 14px;">
            <%- include('../partials/icon', { name: 'check' }) %>
            <span><%= notice %></span>
        </div>
    <% } %>

    <% if (locals.error) { %>
        <div class="alert alert-error" role="alert" style="margin-bottom: 14px;">
            <%- include('../partials/icon', { name: 'alert' }) %>
            <span><%= error %></span>
        </div>
    <% } %>

    <form class="form" action="/reset-password" method="POST">
        <div class="field">
            <label class="label" for="reset-email">Email address</label>
            <input class="input" id="reset-email" type="email" name="email"
                   value="<%= locals.email || '' %>" placeholder="you@example.com"
                   autocomplete="email" required>
        </div>

        <div class="field">
            <label class="label" for="reset-otp">
                Reset code
                <span>6 digits</span>
            </label>
            <input class="input otp-input" id="reset-otp" type="text" name="otp"
                   inputmode="numeric" pattern="[0-9]*" maxlength="6"
                   placeholder="000000" autocomplete="one-time-code" required>
        </div>

        <div class="form-row">
            <div class="field">
                <label class="label" for="reset-password">New password</label>
                <div class="password-field">
                    <input class="input" id="reset-password" type="password" name="password"
                           placeholder="At least 8 characters" autocomplete="new-password" minlength="8" required>
                    <button class="password-toggle" type="button" data-password-toggle="reset-password" aria-label="Show password">
                        <%- include('../partials/icon', { name: 'eye' }) %>
                    </button>
                </div>
            </div>

            <div class="field">
                <label class="label" for="reset-confirm">Confirm password</label>
                <div class="password-field">
                    <input class="input" id="reset-confirm" type="password" name="confirmPassword"
                           placeholder="Repeat new password" autocomplete="new-password" minlength="8" required>
                    <button class="password-toggle" type="button" data-password-toggle="reset-confirm" aria-label="Show password">
                        <%- include('../partials/icon', { name: 'eye' }) %>
                    </button>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <button class="btn btn-primary btn-block" type="submit">Update password</button>
        </div>
    </form>

    <div class="auth-links">
        <a href="/forgot-password">Send a new code</a>
        <a href="/login">Back to sign in</a>
    </div>
</div>

<%- include('../partials/auth-bottom') %>
