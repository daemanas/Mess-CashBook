<%
    const activeMonth = (typeof month !== 'undefined' && month) ? month : (new Date().getMonth() + 1);
    const activeYear = (typeof year !== 'undefined' && year) ? year : new Date().getFullYear();
    const activeLabel = (typeof periodLabel !== 'undefined' && periodLabel)
        ? periodLabel
        : new Date(activeYear, activeMonth - 1).toLocaleString('en', { month: 'long', year: 'numeric' });
    const thisYear = new Date().getFullYear();
    const topYear = Math.max(thisYear, activeYear);
    const bottomYear = Math.min(2020, activeYear);
    const shortMonths = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
%>
<div class="month-picker">
    <button type="button" class="month-trigger" aria-haspopup="true" aria-expanded="false">
        <%- include('icon', { name: 'calendar' }) %>
        <span><%= activeLabel %></span>
        <%- include('icon', { name: 'chevron-down' }) %>
    </button>

    <div class="month-panel" hidden>
        <div class="month-panel-head">
            <strong class="small">Select period</strong>
            <select class="month-year" aria-label="Choose year">
                <% for (let y = topYear; y >= bottomYear; y--) { %>
                    <option value="<%= y %>" <%= y === activeYear ? 'selected' : '' %>><%= y %></option>
                <% } %>
            </select>
        </div>

        <div class="month-grid">
            <% shortMonths.forEach((name, index) => { %>
                <button type="button"
                        class="month-cell <%= (index + 1) === activeMonth ? 'is-active' : '' %>"
                        data-month="<%= index + 1 %>"><%= name %></button>
            <% }) %>
        </div>

        <div class="month-panel-foot">
            <a href="#" class="month-reset">This month</a>
            <span class="small muted">Filters this page</span>
        </div>
    </div>
</div>
